{
  "name": "cctui-ghreview-ui",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "preinstall": "case \"$npm_config_user_agent\" in bun*) exit 0 ;; esac; [ \"$INIT_CWD\" = \"$PWD\" ] || exit 0; echo '' >&2; echo 'ghreview-ui is a bun project (bun.lock, no package-lock.json).' >&2; echo 'Run: bun install' >&2; echo '' >&2; exit 1",
    "dev": "vite",
    "build": "vite build",
    "build:plugin": "bun scripts/build-plugin.ts",
    "preview": "vite preview --host",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "happy-dom": "^20.14.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dorsk/tsumikit": "^0.64.0",
    "@tanstack/svelte-query": "^6.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  }
}
